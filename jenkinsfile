pipeline {
    agent any
 
    tools {
        maven 'Maven3'
    }
 
    environment {
        SONAR_TOKEN = credentials('sonar-token') // Jenkins credential ID
    }
 
    stages {
        stage('Checkout') {
            steps {
git 'https://github.com/pvreddy1/GeneralSpringBootProgExce.git'
            }
        }
 
        stage('Build') {
            steps {
                sh 'mvn clean install'
            }
        }
 
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQubeServer') {
                    sh "mvn sonar:sonar -Dsonar.projectKey=GeneralSpringBootProgExce -Dsonar.login=$SONAR_TOKEN"
                }
            }
        }
    }
}
